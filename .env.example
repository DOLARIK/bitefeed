# Postgres connection string (Supabase/Neon in production, local Postgres in dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bitefeed

# HTTP server
PORT=3000
# Base URL this service is reachable at — used to build cert URLs in logs/output.
PUBLIC_BASE_URL=http://localhost:3000

# Ed25519 keypair used to sign certificates. Generate with:
#   npm run generate-signing-keys
CERT_SIGNING_PRIVATE_KEY=
CERT_SIGNING_PUBLIC_KEY=

# GitHub App used for drift detection (optional — connect_repo and the webhook
# handler degrade gracefully without these, see README "Network calls" section).
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
